<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <application android:allowBackup="false" android:label="Radar 2.0 Mobile"
   android:usesCleartextTraffic="false"
   android:theme="@android:style/Theme.Material.NoActionBar"
   android:icon="@drawable/radar_icon">
  <activity android:name=".MobileActivity" android:launchMode="singleTop" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
   <!-- Verified Android App Link: the HTTPS URL in the QR code. -->
   <intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="https"
      android:host="radar-2-0-littleghoost.fly.dev"
      android:path="/mobile/pair.html"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
