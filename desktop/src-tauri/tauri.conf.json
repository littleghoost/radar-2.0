{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radar 2.0",
  "version": "0.2.2",
  "identifier": "com.littleghoost.radar2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/radar-backend"
    ],
    "resources": [
      "resources/models/**/*"
    ]
  }
}
