# Servidor
PORT=3000
DB_PATH=./data/radar.db

# Login do Radar (obrigatório fora do modo desktop)
# Sem RADAR_PASSWORD e SESSION_SECRET a autenticação fica DESATIVADA e a API
# inteira fica pública. Em produção (NODE_ENV=production) o servidor se recusa
# a iniciar sem elas.
RADAR_PASSWORD=troque-por-uma-senha-longa
SESSION_SECRET=um_valor_longo_e_aleatorio

# Mercado Livre
ML_CLIENT_ID=your_mercado_livre_app_id
ML_CLIENT_SECRET=your_mercado_livre_secret
ML_REDIRECT_URI=https://radar-2-0-littleghoost.fly.dev/auth/mercadolivre/callback
OAUTH_STATE_SECRET=generate_a_long_random_value
