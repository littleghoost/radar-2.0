{
  "manifest_version": 3,
  "name": "Radar 2.0 Bridge",
  "version": "0.2.1",
  "description": "Sincroniza anúncios visíveis com a Inbox inteligente do Radar 2.0.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:3130/*",
    "http://localhost:3130/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.olx.com.br/*",
        "*://*.mercadolivre.com.br/*",
        "*://*.mercadolibre.com/*",
        "*://*.ebay.com/*",
        "*://*.depop.com/*"
      ],
      "js": ["collector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Radar 2.0 Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
